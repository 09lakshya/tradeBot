# ─── Application ───────────────────────────────────────────────
APP_ENV=local                     # local | staging | production
APP_DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (PostgreSQL + TimescaleDB) ───────────────────────
POSTGRES_USER=tradebot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradebot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived in config.py from the parts above — UNLESS DATABASE_URL is
# set, which then wins verbatim. Use it for a managed cloud instance (TLS +
# URL-encoded password), e.g. Timescale Cloud:
# DATABASE_URL=postgres://user:pass@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# ─── Redis (cache + Celery broker/result backend) ──────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL wins verbatim when set — required for cloud Redis (auth + TLS), e.g.:
# REDIS_URL=rediss://default:pass@xxxx.upstash.io:6379/0

# ─── Market data providers (never commit real keys) ────────────
# Switching providers is config-only — no code change required.
MARKET_DATA_PROVIDER=yahoo         # yahoo | alpha_vantage | twelve_data | finnhub | mock
# Comma-separated failover chain, tried in order after the primary fails.
MARKET_DATA_FALLBACKS=
MARKET_DATA_RATE_PER_SEC=5
MARKET_DATA_BURST=10
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_TIMEOUT=15

ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# ─── Frontend ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Autonomous paper trading -------------------------------------------
# The loop starts with the API and idles until NSE regular hours (09:15-15:30
# IST, weekdays, non-holidays), so it begins trading by itself at the open.
AUTOTRADER_ENABLED=true
# One decision cycle every 15 minutes.
AUTOTRADER_INTERVAL_SECONDS=900
# Most liquid N of the 500-name watchlist.
AUTOTRADER_SYMBOL_LIMIT=200
# A signal carries its bar's timestamp. The newest completed daily bar is
# yesterday's, which is already ~28h old at today's 09:15 open, so a 24h TTL
# expires every signal before the session starts and nothing ever trades.
# 48h keeps the last completed session actionable through the next one.
AUTOTRADER_SIGNAL_TTL_SECONDS=172800
# Blank = every registered strategy. NOTE: keep comments on their own line --
# dotenv does not strip an inline comment from an EMPTY value, so
# `KEY=   # note` parses as the literal text of the note.
AUTOTRADER_STRATEGIES=
# Blank = the oldest wallet, which is the one the dashboard shows.
AUTOTRADER_PORTFOLIO_ID=
